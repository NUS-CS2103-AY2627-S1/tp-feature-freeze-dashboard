rmissions and restrict DOS test to Windows","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":21,"deletions":6},"test-code":{"insertions":3,"deletions":0}}}]}],"HONYIEN":[{"date":"2026-11-02T00:00:00","commitResults":[{"hash":"49869fb03fbb972c4c0fd5dd16359430aefc4c97","isMergeCommit":false,"messageTitle":"docs: Clarify meeting midnight restrictions","messageBody":"The User Guide leaves midnight and overnight meeting limits implicit.\n\nDocument that 2400 is rejected and 0000 is allowed only as a start\ntime. Explain that meetings must end on the same date, including\nwhen using force/ with addm or editm.\n\nFixes #211\n","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":1}}},{"hash":"6308e6e6ba9c2154fc1da9b7575415a727da4f3d","isMergeCommit":false,"messageTitle":"Allow printable ASCII in meeting names","messageBody":"Meeting-name validation rejects ordinary titles containing digits\nand punctuation, such as Q4 Review and Budget/Planning.\n\nAccept nonblank printable ASCII names and preserve space and tab\nnormalization. Update tests and document prefix collisions and\nliteral quote behavior.\n\nFixes #206\n","fileTypesAndContributionMap":{"functional-code":{"insertions":10,"deletions":13},"docs":{"insertions":13,"deletions":4},"test-code":{"insertions":87,"deletions":18}}},{"hash":"80a7e1afa7c52c531eb05c2c74b7c37bf0ebbf4e","isMergeCommit":true,"messageTitle":"Merge pull request #218 from HONYIEN/211-document-meeting-midnight-limitations","messageBody":"docs: Clarify meeting midnight restrictions","fileTypesAndContributionMap":{}},{"hash":"85ee8b1b1eca7d606e64470c312ee047eb88d31c","isMergeCommit":false,"messageTitle":"Add logging and assertions for meeting commands","messageBody":"Meeting command outcomes lack diagnostic context.\n\nLog rejections, forced overlaps, and filter visibility for addm\nand editm. Assert edit prerequisites, overlap exclusion, and\nfull-list postconditions to catch internal contract violations.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":28,"deletions":3}}}]},{"date":"2026-11-03T00:00:00","commitResults":[{"hash":"51a999f0dce9cf78e015b05b983407ec8efd379b","isMergeCommit":false,"messageTitle":"Restrict meeting dates to four-digit years","messageBody":"Meeting dates accept signed and extended years despite the documented\nDD/MM/YYYY format.\n\nRequire years from 0001 to 9999, update the date guidance, and add\nregression tests for adding, editing, and loading meetings.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":12,"deletions":5},"docs":{"insertions":1,"deletions":1},"test-code":{"insertions":47,"deletions":0}}}]}],"bibikowlf":[{"date":"2026-10-30T00:00:00","commitResults":[{"hash":"e9fc4005ef3d07b7d131df56503b325ca5294ded","isMergeCommit":true,"messageTitle":"Merge pull request #189 from kaih4n/fix-meeting-name-message","messageBody":"Fix error message for invalid meeting name","fileTypesAndContributionMap":{}}]},{"date":"2026-10-31T00:00:00","commitResults":[{"hash":"53bb86a41aba3bb66429ff5ccef9289e177bd4cb","isMergeCommit":false,"messageTitle":"Document test heuristics","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":32,"deletions":0}}},{"hash":"fda1fc72816309a99977b91b6c2a84de0c1eba15","isMergeCommit":false,"messageTitle":"Document test heuristics","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":20,"deletions":5}}},{"hash":"da94e513211cd4520ff09c47100f9c556256723f","isMergeCommit":false,"messageTitle":"Acknowledge AI use in DG","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":0}}},{"hash":"86f0be8333c6b38d323e497a5aedd27ac9d4f896","isMergeCommit":false,"messageTitle":"Fix UG and DG section hyperlinks","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":3}}}]},{"date":"2026-11-01T00:00:00","commitResults":[{"hash":"74d025ffbecd159cbc096b18f988d770a2840aea","isMergeCommit":false,"messageTitle":"Change status me