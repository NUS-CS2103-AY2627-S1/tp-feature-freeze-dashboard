{"authorDailyContributionsMap":{"vutuanlong07":[{"date":"2026-10-30T00:00:00","commitResults":[{"hash":"2acefe6b79dbc98ce2ea221b118c236e9b494b92","isMergeCommit":false,"messageTitle":"Fix typos","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":4}}},{"hash":"9ab9b54e858afb31c3cca83cbaa85294212db8c0","isMergeCommit":false,"messageTitle":"Remove unused imports, fix typo in findj help page","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":4}}}]},{"date":"2026-11-01T00:00:00","commitResults":[{"hash":"e78a335bcbbd7e7c4324bf666d7cbdc827d7dddb","isMergeCommit":false,"messageTitle":"Fix more typos and missing sections","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":20,"deletions":9}}}]}],"SzeTingT":[],"PenguinPiplup":[{"date":"2026-10-30T00:00:00","commitResults":[{"hash":"9cbf92fffb63f70a9f7807d021cd2d0f570c57d1","isMergeCommit":false,"messageTitle":"Fix comment in AbstractFindCommand","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1}}},{"hash":"731d4add18a3de8674a219d33b4f0bcea3022768","isMergeCommit":false,"messageTitle":"Remove unused imports in SectionHyperlink.java","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":0,"deletions":3}}},{"hash":"a1e5f46a56662342ccacac9a1b8c24c71366d446","isMergeCommit":false,"messageTitle":"Remove duplicated code in find command tests","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":315,"deletions":451}}},{"hash":"29cd374523de46647748d5f14a6f3b7eb1d90b92","isMergeCommit":false,"messageTitle":"Add more edge test cases for find commands","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":98,"deletions":0}}}]},{"date":"2026-10-31T00:00:00","commitResults":[{"hash":"a4467e9f9d45556ec963a2465b2e764f1e0a26d9","isMergeCommit":true,"messageTitle":"Merge pull request #173 from vutuanlong07/tp-133-alt","messageBody":"Fix typos in in-app user guide","fileTypesAndContributionMap":{}},{"hash":"ed80c3b8093fe8a8c3c0f317963da869589f11ed","isMergeCommit":false,"messageTitle":"Add missing parseCommand_addc test","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":19,"deletions":1}}},{"hash":"8ba84e98e3f026adae3c8491ff207a7e1771309d","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-improve-test-coverage","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"60f96a7273004521533088f1d763bbb49385a762","isMergeCommit":false,"messageTitle":"Update edit command test classes","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":87,"deletions":1}}}]},{"date":"2026-11-01T00:00:00","commitResults":[{"hash":"32b504f0d889f6f123939ee6a3622c0c33abd4e2","isMergeCommit":false,"messageTitle":"Add MainApp tests","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":300,"deletions":0}}},{"hash":"7002c3a48a79fd39e450c56976fd6d958758f7eb","isMergeCommit":false,"messageTitle":"Fix startup crash on null values in JSON files","messageBody":"A hand-edited data or preferences file can contain a JSON null where\nthe app expects a value. Jackson parses this without error, so the null\nreaches later code and causes a NullPointerException. MainApp only\ncatches DataLoadingException, so its fallback for invalid files is\nskipped and the app exits without opening a window. The user guide lets\nadvanced users edit the data file and says an invalid file starts the\napp with empty lists, so this breaks documented behaviour.\n\nLet\u0027s treat each of these cases as invalid data, so the existing\nfallbacks apply:\n\n* JsonUtil#readJsonFile: a file containing only null. This affects both\n  the data file and the preferences file.\n* JsonUserPrefsStorage#readUserPrefs: a null guiSettings. Jackson sets\n  the field directly, which bypasses the null check in\n  UserPrefs#setGuiSettings.\n* JsonSerializableAddressBook#toModelType: a null jobseeker or client\n  entry.\n* JsonAdaptedJobseeker#toModelType and JsonAdaptedClient#toModelType: a\n  null tag entry.\n\nNull is rejected as invalid file rather than treated as a missing file.\nUsing Optional.ofNullable in readJsonFile would make the app load the\nsample data and overwrite the user\u0027s file.\n\nAn invalid preferences file now falls back to the defaults and is\nrepaired. An invalid data file starts the app with empty lists and stays\non disk until the next command is run. MainApp itself does not change.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":29,"deletions":1},"test-code":{"insertions":161,"deletions":0}}},{"hash":"5ab0f2e839f119c17df0b3a933c45fb6750f62f6","isMergeCommit":false,"messageTitle":"Add hash code tests","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":77,"deletions":0}}},{"hash":"73c46549cc6df087f6f725ee0e04496db0bcffad","isMergeCommit":false,"messageTitle":"Add tests for four uncovered methods","messageBody":"LogicManager#setGuiSettings, StorageManager#getUserPrefsFilePath,\nUniquePersonList#iterator and ModelManager#setAddressBook are not called\nby any test. Each one only passes the call on to another object, so a\nmistake in the wiring would go unnoticed: window settings would not be\nsaved, for example, or the wrong file path would be returned.\n\nLet\u0027s add tests for these methods:\n\n* setGuiSettings: null and valid settings, checking that valid settings\n  reach the model\n* getUserPrefsFilePath: the exact path, because a non-null check would\n  still pass if the address book path were returned instead\n* iterator: lists of 0, 1 and 2 people, returned in list order\n* setAddressBook: a null book, and replacement books with no people,\n  only jobseekers, only clients, and both\n\nLet\u0027s also check that setAddressBook keeps hidden people hidden. The\nfilter set by the constructor has to apply to the new data, or replacing\nthe data would reveal those people.\n","fileTypesAndContributionMap":{"test-code":{"insertions":96,"deletions":0}}},{"hash":"410e0e63d40478fbefca9b1f991077726e522c0b","isMergeCommit":false,"messageTitle":"Edit test names for FindJobseekerCommandTest","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":7,"deletions":7}}},{"hash":"7be4018c385298e71adef63872ca0c28306409a7","isMergeCommit":true,"messageTitle":"Merge pull request #167 from kkyingovo/branch-use-cases","messageBody":"Update Developer Guide use cases for accuracy and consistency","fileTypesAndContributionMap":{}},{"hash":"70018fa7586881afb6ae043dbdbd8f35b60c0a64","isMergeCommit":true,"messageTitle":"Merge pull request #176 from PenguinPiplup/branch-update-find-command-tests","messageBody":"Update find command tests","fileTypesAndContributionMap":{}},{"hash":"13a0a137012cf7d1bd07e4e21efeefee5bf97cd5","isMergeCommit":false,"messageTitle":"Add dedicated message for null tag entries in JSON files","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":2},"test-code":{"insertions":4,"deletions":4}}},{"hash":"ea6986c6b87e94e4111c464d5732f45ffb63f03c","isMergeCommit":true,"messageTitle":"Merge pull request #182 from PenguinPiplup/branch-fix-null-json-startup-crash","messageBody":"Fix startup crash on null values in JSON files","fileTypesAndContributionMap":{}},{"hash":"675357a2589f157ed320eab731bc2b6989a1b11b","isMergeCommit":false,"messageTitle":"Remove ignored ParticipantPadding setting from diagram style","messageBody":"PlantUML v1.2026.9 no longer supports `skinparam ParticipantPadding`.\nIt draws a yellow warning box into every diagram that includes\nstyle.puml, while still exiting successfully.\n\nDelete the setting rather than using the `\u003cstyle\u003e` replacement that\nthe warning suggests. The setting is already ignored, so deleting it\nkeeps the current layout, whereas the replacement makes the participant\nboxes and the diagram slightly larger.\n","fileTypesAndContributionMap":{"docs":{"insertions":0,"deletions":1}}},{"hash":"dc8721c41e423cf4d5022b29275806944895b2b4","isMergeCommit":false,"messageTitle":"Update UI section of DG","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":16,"deletions":3}}},{"hash":"cec800903069364dca188bd7cc7e2370c31fc124","isMergeCommit":false,"messageTitle":"Make further refinements to DG UI section","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":9,"deletions":9}}},{"hash":"d0bbe0e55fbd165e414970d9c4ba394e171cb9ed","isMergeCommit":false,"messageTitle":"Make further refinements to DG UI section","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":6,"deletions":2}}},{"hash":"b4abc579376e64b0ec0bcfbfb9a6c7eeb7cc03bb","isMergeCommit":false,"messageTitle":"Update AboutUs.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":12}}},{"hash":"39868a4818d6485dcbf2b916df0bf80b10f0c7e9","isMergeCommit":false,"messageTitle":"Remove archiving data files section from UG","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":0,"deletions":4}}},{"hash":"378773ee12ce9dd1122474136d235095c07c0115","isMergeCommit":true,"messageTitle":"Merge pull request #192 from vutuanlong07/tp-133-alt","messageBody":"Fix more typos and missing sections","fileTypesAndContributionMap":{}}]},{"date":"2026-11-02T00:00:00","commitResults":[{"hash":"39d0b4c96d9d684b6e516101f2ca1ac34bddf12d","isMergeCommit":false,"messageTitle":"Fix factual inaccuracies for find commands","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":4}}},{"hash":"0994cfed74d57bbce61a21bb871f5b7f76798f45","isMergeCommit":false,"messageTitle":"Update contacts common info","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":13,"deletions":6}}},{"hash":"698876d8f31f91b0d6efba2548d12360500a7fc9","isMergeCommit":false,"messageTitle":"Update inaccuracy in editj in UG","messageBody":"","fileTypesAndContributionMap":{"d